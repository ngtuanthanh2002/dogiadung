# Domain website (dùng cho sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://daikieu.com

# ── Đăng nhập Google (Auth.js) ──
# Tạo chuỗi bí mật: npx auth secret   (hoặc bất kỳ chuỗi ngẫu nhiên dài ≥ 32 ký tự)
AUTH_SECRET=

# Tạo OAuth Client tại https://console.cloud.google.com/apis/credentials
#   Loại: Web application
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#                            https://<domain-cua-ban>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
