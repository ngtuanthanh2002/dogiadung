# Sao chép file này thành .env.local rồi điền giá trị. Hướng dẫn từng bước: docs/setup.md
# KHÔNG commit .env.local lên git.

# Domain website (dùng cho sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://phungo.vn

# ── Neon PostgreSQL (sản phẩm, danh mục, đơn hàng) ──
# Neon Console → Project → nút "Connect" → bật "Connection pooling" → copy chuỗi kết nối
DATABASE_URL=postgresql://neondb_owner:xxxxxxxx@ep-xxxx-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── ImageKit (ảnh sản phẩm, danh mục) ──
# ImageKit Dashboard → Developer options → API keys
# Private key bắt đầu bằng "private_" — TUYỆT ĐỐI không đưa lên git / không gửi cho ai
IMAGEKIT_PRIVATE_KEY=
# URL-endpoint, ví dụ https://ik.imagekit.io/tencuaban (không có dấu "/" ở cuối)
IMAGEKIT_URL_ENDPOINT=

# ── Đăng nhập quản trị (Auth.js) ──
# Chuỗi bí mật mã hóa phiên: chạy "npx auth secret" hoặc bất kỳ chuỗi ngẫu nhiên ≥ 32 ký tự
AUTH_SECRET=
# Tài khoản quản trị duy nhất. Mật khẩu tối thiểu 12 ký tự (ngắn hơn sẽ bị từ chối đăng nhập).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
